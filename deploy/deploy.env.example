# Настройки скриптов deploy/ (не секреты приложения). Скопируйте в deploy/deploy.env:
#   cp deploy/deploy.env.example deploy/deploy.env && chmod 600 deploy/deploy.env
# Файла deploy/deploy.env нет в git, обновления его не трогают.

# Ветка, из которой deploy.sh берёт обновления
DEPLOY_BRANCH=main
# Сколько секунд ждать, пока новая версия станет healthy, прежде чем откатиться
HEALTH_TIMEOUT=120

# Сколько дней хранить ежедневные копии на сервере
BACKUP_KEEP_DAYS=14
# Шифрование копий. Задайте ОДНО из двух (закрытый ключ хранится НЕ на сервере):
#  • сертификат OpenSSL (открытая часть), см. docs/aws-deploy.md, раздел «Ключ для копий»
BACKUP_CERT=/opt/gh-tg-web/deploy/backup-cert.pem
#  • или открытый ключ age (если установлен age): age1...
# BACKUP_AGE_RECIPIENT=
# Без шифрования только осознанно (например, для проверки на своём компьютере):
# BACKUP_ENCRYPT=0

# Выгрузка копий в S3 через роль IAM инстанса (необязательно). Пусто — только локально.
# S3_BUCKET=my-gh-tg-web-backups
# S3_PREFIX=gh-tg-web
