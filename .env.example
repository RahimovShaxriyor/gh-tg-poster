# Входа по общему паролю нет: каждый регистрируется на сайте сам (имя и пароль).
SESSION_SECRET=случайная-строка-минимум-32-символа
ENCRYPTION_KEY=случайный-ключ-для-шифрования-токенов-в-бд
DOMAIN=poster.example.com
PORT=3000

# Регистрация открыта всем. 0 — закрыть (например, для личного сервера после создания своего аккаунта).
# REGISTRATION_OPEN=1
# Сколько аккаунтов можно создать за час на весь сервер (с одного адреса — 3 в час и 5 в сутки).
# REGISTRATION_LIMIT_PER_HOUR=100

# Токен от @BotFather, один на весь сервис (команда /newbot). Без него сервер работает, но бот выключен.
TG_BOT_TOKEN=
# Внешний адрес панели, если он отличается от https://DOMAIN (например, другой порт или путь).
# От него зависят ссылки в сообщениях бота и адреса возврата приложения GitHub.
# PUBLIC_URL=https://poster.example.com

# GitHub: каждый пользователь создаёт своё приложение кнопкой «Подключить GitHub» или вводит свой токен.
# Общее приложение из переменных ниже пользователям сайта не выдаётся: его установки не привязаны
# к людям, и любой мог бы указать чужую установку. Переменные оставлены для совместимости.

# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_PRIVATE_KEY_B64=base64-содержимое-ключа-pem
# Либо путь к .pem файлу:
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
