# .env для сервера. Создайте рядом с docker-compose.yml:
#   cp .env.production.example .env && chmod 600 .env
# Случайные значения: sh deploy/gen-secrets.sh (печатает их один раз).
# Файла .env нет в git: обновления (deploy/deploy.sh и CI/CD) его не трогают.

# Пароль входа в панель. Длинный и НОВЫЙ: не тот, что был на локальной машине или в тестах.
ADMIN_PASSWORD=

# Ключ подписи cookie сессии: случайная строка не короче 32 символов (openssl rand -hex 32).
# Смена ключа завершает все сессии.
SESSION_SECRET=

# Ключ шифрования токенов и ключей в базе (AES-256-GCM): openssl rand -hex 32.
# СОХРАНИТЕ ЕГО ОТДЕЛЬНО (менеджер паролей). Без него секреты в базе и в её копиях не расшифровать:
# после потери ключа токен GitHub и ключ ИИ придётся ввести в панели заново.
ENCRYPTION_KEY=

# Токен бота от @BotFather (/newbot). Один бот — один процесс: перед запуском на сервере
# остановите локальную копию, иначе два процесса будут перехватывать сообщения друг у друга.
TG_BOT_TOKEN=

# Домен панели с A-записью на Elastic IP. Caddy получит для него сертификат Let's Encrypt.
# На голый IP сертификат не выпускается.
DOMAIN=poster.example.com

# Внешний адрес панели. Обычно не нужен: по умолчанию https://DOMAIN.
# От него зависят ссылки в сообщениях бота и адреса возврата приложения GitHub.
# PUBLIC_URL=https://poster.example.com

# Порт приложения внутри контейнера (наружу не публикуется, к нему ходит только Caddy)
PORT=3000

# Пользователь контейнера = владелец папок data и backups на хосте (пользователь deploy).
# Узнать: id -u deploy и id -g deploy. Права: sudo chown -R deploy:deploy /opt/gh-tg-web/data /opt/gh-tg-web/backups
APP_UID=1001
APP_GID=1001

# GitHub App: обычно НЕ нужно — панель создаёт приложение кнопкой «Подключить GitHub».
# Запасной способ для приложения, созданного вручную:
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_APP_PRIVATE_KEY_B64=base64-содержимое-ключа-pem
# GITHUB_APP_PRIVATE_KEY_PATH=/app/data/github-app.pem

# APP_VERSION задаёт deploy.sh при сборке (короткий sha коммита), вписывать не нужно.
